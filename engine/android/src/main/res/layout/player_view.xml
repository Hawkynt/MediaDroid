<?xml version="1.0" encoding="utf-8"?>
<!-- SurfaceView: pictures go straight to the compositor at the refresh they are meant for. The colour correction
     is the filter stage's last pass (see VideoFilterStage), so no view effect has to reach the picture. -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="surface_view" />
