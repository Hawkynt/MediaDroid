// RIFE's warp for ncnn on Vulkan (after rife-ncnn-vulkan's, MIT, see app/THIRD-PARTY-NOTICE.RIFE.txt): each
// value of a blob sampled where the flow points from its pixel, bilinear. ncnn defines sfp/afp and the
// buffer_ld1/buffer_st1 helpers for the storage it chose; the layer takes blobs unpacked, a channel per plane.
#version 450

#if NCNN_fp16_storage
#extension GL_EXT_shader_16bit_storage: require
#endif
#if NCNN_fp16_arithmetic
#extension GL_EXT_shader_explicit_arithmetic_types_float16: require
#endif

layout (binding = 0) readonly buffer image_blob { sfp image_blob_data[]; };
layout (binding = 1) readonly buffer flow_blob { sfp flow_blob_data[]; };
layout (binding = 2) writeonly buffer top_blob { sfp top_blob_data[]; };

layout (push_constant) uniform parameter {
    int w;
    int h;
    int c;
    int cstep;
} p;

void main() {
    int gx = int(gl_GlobalInvocationID.x);
    int gy = int(gl_GlobalInvocationID.y);
    int gz = int(gl_GlobalInvocationID.z);
    if (gx >= p.w || gy >= p.h || gz >= p.c) return;

    // The flow is one blob of two planes, across and down, in pixels.
    afp sampleX = afp(gx) + buffer_ld1(flow_blob_data, gy * p.w + gx);
    afp sampleY = afp(gy) + buffer_ld1(flow_blob_data, p.cstep + gy * p.w + gx);

    int x0 = int(floor(sampleX));
    int y0 = int(floor(sampleY));
    // The weights from the corner after clamping, exactly as the reference computes them: the network was
    // converted against this sampling.
    afp alpha = sampleX - afp(clamp(x0, 0, p.w - 1));
    afp beta = sampleY - afp(clamp(y0, 0, p.h - 1));
    int x1 = clamp(x0 + 1, 0, p.w - 1);
    int y1 = clamp(y0 + 1, 0, p.h - 1);
    x0 = clamp(x0, 0, p.w - 1);
    y0 = clamp(y0, 0, p.h - 1);

    int plane = gz * p.cstep;
    afp v0 = buffer_ld1(image_blob_data, plane + y0 * p.w + x0);
    afp v1 = buffer_ld1(image_blob_data, plane + y0 * p.w + x1);
    afp v2 = buffer_ld1(image_blob_data, plane + y1 * p.w + x0);
    afp v3 = buffer_ld1(image_blob_data, plane + y1 * p.w + x1);
    afp top = v0 * (afp(1.f) - alpha) + v1 * alpha;
    afp bottom = v2 * (afp(1.f) - alpha) + v3 * alpha;

    buffer_st1(top_blob_data, plane + gy * p.w + gx, top * (afp(1.f) - beta) + bottom * beta);
}
